# Local development only. Replace all four passwords before starting.
# Generate each password with: python3 -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_PASSWORD=replace-with-a-unique-owner-password
METRICS_WRITER_PASSWORD=replace-with-a-unique-writer-password
GRAFANA_READER_PASSWORD=replace-with-a-unique-reader-password
GRAFANA_ADMIN_PASSWORD=replace-with-a-unique-admin-password

# Bound to localhost; change these if another project uses the same ports.
POSTGRES_PORT=55432
GRAFANA_PORT=53000
