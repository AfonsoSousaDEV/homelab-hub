{
  "id": null,
  "uid": "homelab-workflow-runs",
  "title": "Workflow executions",
  "description": "Workflow attempts by start time. Success rate excludes running attempts; duration includes successful and failed completions. The demo-email-digest workflow is synthetic.",
  "tags": [
    "homelab",
    "metrics"
  ],
  "timezone": "utc",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Workflow attempts",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT count(*) AS attempts FROM metrics.run_metrics WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Success rate (finished attempts)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status = 'succeeded') / nullif(count(*) FILTER (WHERE status <> 'running'), 0) AS success_rate FROM metrics.run_metrics WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No finished runs"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "P95 end-to-end duration",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS p95_ms FROM metrics.run_metrics WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No finished runs"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Emails summarized",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT coalesce(sum(emails_summarized), 0) AS emails FROM metrics.run_metrics WHERE $__timeFilter(started_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Attempts per hour by status",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at, '1h', 0), status AS metric, count(*) AS value FROM metrics.run_metrics WHERE $__timeFilter(started_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "title": "End-to-end duration per hour",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(started_at, '1h'), avg(duration_ms) AS mean_ms, percentile_cont(0.95) WITHIN GROUP (ORDER BY duration_ms) AS p95_ms FROM metrics.run_metrics WHERE $__timeFilter(started_at) AND finished_at IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "title": "Recent attempts (up to 50)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT started_at, workflow_key, execution_key, status, emails_total, emails_summarized, emails_failed, round(duration_ms, 2) AS duration_ms, error_code FROM metrics.run_metrics WHERE $__timeFilter(started_at) ORDER BY started_at DESC LIMIT 50",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 8,
      "title": "Failure categories",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT error_code, count(*) AS attempts FROM metrics.run_metrics WHERE $__timeFilter(started_at) AND status = 'failed' GROUP BY error_code ORDER BY attempts DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 9,
      "title": "Running for over 15 minutes",
      "description": "Current unfinished attempts older than 15 minutes across all history. This indicator is independent of the dashboard time range; old attempts remain visible until reconciled.",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "homelab-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "homelab-postgres"
          },
          "rawSql": "SELECT count(*) AS stale_runs FROM metrics.run_metrics WHERE status = 'running' AND started_at < now() - interval '15 minutes'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    }
  ],
  "editable": false,
  "links": []
}
