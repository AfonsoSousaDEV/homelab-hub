# Copy this file to .env and fill in your own values. NEVER commit .env.
# Generate the two random values with:  openssl rand -hex 32
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Where n8n finds Ollama. The default works when Ollama runs on the same PC as Docker.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b

# Discord channel -> Edit Channel -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
