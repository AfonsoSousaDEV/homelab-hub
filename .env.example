# Copy to .env (or run ./scripts/init-env.sh, which fills in the secrets for you).
# Never commit .env: it is git-ignored on purpose.

# Which compose files to use. Add the GPU override on machines with an NVIDIA card:
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml
COMPOSE_FILE=compose.yaml

TZ=Europe/Lisbon

# Postgres (shared by n8n and the "hub" database)
POSTGRES_USER=hub
POSTGRES_PASSWORD=
POSTGRES_DB=n8n

# n8n: generate with `openssl rand -hex 32`. Losing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=
# Pin versions after the first successful start (e.g. a specific n8n release) to avoid surprise upgrades.
N8N_VERSION=latest
# Keep "true" on localhost. Over plain http on a VPN IP the login cookie is rejected;
# set "false" only for that case and only inside the VPN.
N8N_SECURE_COOKIE=true

OLLAMA_VERSION=latest
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_KEEP_ALIVE=5m

# Interface the ports are published on. 127.0.0.1 = this machine only.
# For the group VPN, set it to the VPN interface address, never to 0.0.0.0.
BIND_ADDRESS=127.0.0.1

# Homelab API and email workflow
APP_DB_NAME=homelab
API_KEY=
API_BASE_URL=http://api:8000
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b
DISCORD_WEBHOOK_URL=
